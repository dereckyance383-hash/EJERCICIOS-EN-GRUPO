Algoritmo Ejercicio17
    Definir a, b, perimetro, area Como Real
    Escribir "Ingrese el primer lado del rectangulo:"
    Leer a
    Escribir "Ingrese el segundo lado del rectangulo:"
    Leer b
    perimetro <- 2 * a + 2 * b
    area <- a * b
    Escribir "Perimetro del rectangulo: ", perimetro
    Escribir "Area del rectangulo: ", area
FinAlgoritmo
